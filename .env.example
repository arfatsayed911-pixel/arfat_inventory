# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. Supabase (Database, Auth, Storage)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Resend (Email Alerts for Low Stock & System Notifications)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefg
RESEND_FROM_EMAIL=inventory@yourdomain.com
ALERT_RECIPIENT_EMAIL=admin@yourdomain.com

# 3. Application URL (used for email action links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

